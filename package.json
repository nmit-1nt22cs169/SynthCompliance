{
  "name": "synthcompliance-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "uvicorn app.main:app --reload --port 8000 --app-dir services/api",
    "dev:mock1": "node scripts/load-mock-data.mjs 1",
    "dev:mock2": "node scripts/load-mock-data.mjs 2",
    "dev:mock3": "node scripts/load-mock-data.mjs 3",
    "seed": "python scripts/generate_seed.py",
    "golden": "python scripts/generate_golden.py",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
