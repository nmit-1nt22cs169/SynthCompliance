FROM python:3.12-slim

WORKDIR /app

COPY packages/taxonomy packages/taxonomy
COPY packages/validators packages/validators
COPY packages/generators packages/generators
COPY packages/agents packages/agents
COPY services/api services/api
COPY scripts scripts
COPY data/seeds data/seeds

RUN pip install --no-cache-dir \
    -e packages/taxonomy \
    -e packages/validators \
    -e packages/generators \
    -e packages/agents \
    -r services/api/requirements.txt

RUN mkdir -p public/data

ENV SYNTH_DATA_DIR=/app/public/data
ENV SYNTH_SEED_DIR=/app/data/seeds

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--app-dir", "services/api"]
