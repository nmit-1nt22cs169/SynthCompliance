# USE_SELF_HOSTED picks which pair below is active. Both can stay filled in at once —
# flipping this one switch is all you need, nothing else to retype.
USE_SELF_HOSTED=false

# Hosted/cloud LLM API (e.g. NVIDIA Build API) — used when USE_SELF_HOSTED=false
PRIVATE_API_KEY=
PRIVATE_BASE_URL=https://integrate.api.nvidia.com/v1
HOSTED_LLM_MODEL=nvidia/nemotron-3-super

# Self-hosted / local path — used when USE_SELF_HOSTED=true. Also works for a local
# Ollama instance, which serves an OpenAI-compatible API and can host multiple models
# at once (selected per-request via the model name, not the URL):
#   LOCAL_BASE_URL=http://localhost:11434/v1
#   LOCAL_API_KEY=ollama          # ignored by Ollama, but must be non-empty
#   LOCAL_LLM_MODEL=llama3.1      # or whatever you've `ollama pull`ed
LOCAL_BASE_URL=http://localhost:8000/v1
LOCAL_API_KEY=not-needed
LOCAL_LLM_MODEL=

# Data output directory (dashboard polls public/data/)
SYNTH_DATA_DIR=./public/data

# When true, this run's TSTR comparison can trigger retraining: the persisted
# logistic-regression classifier (packages/validators/synthcompliance_validators/tstr.py,
# free/instant, always eligible), and — once configured below — a second LLM (the
# target architecture's Copilot-answering model, retrained on the same regression
# signal; not yet built). Off by default — each run trains a fresh throwaway
# classifier, same as before this flag existed.
RETRAIN_MODEL=false

# Retrain-target model access (only relevant once RETRAIN_MODEL=true and the second
# model exists — any LLM works here, not tied to a specific one). All four below are
# optional overrides — leave unset to reuse the generation model's USE_SELF_HOSTED/
# base_url/api_key above (the common case: the retrain model served from the same
# place, just a different model name). Only fill these in if it's genuinely hosted
# somewhere else (a different cluster, a different provider).
# RETRAIN_USE_SELF_HOSTED=
# RETRAIN_LOCAL_BASE_URL=
# RETRAIN_LOCAL_API_KEY=
# RETRAIN_LOCAL_LLM_MODEL=
# RETRAIN_PRIVATE_BASE_URL=
# RETRAIN_PRIVATE_API_KEY=
# RETRAIN_HOSTED_LLM_MODEL=
