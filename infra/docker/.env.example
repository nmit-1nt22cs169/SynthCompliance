# NVIDIA Build API (primary) — set NVIDIA_API_KEY for live Nemotron polish
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super

# Self-hosted NIM on GPU cluster (production/demo path)
# Also works for a local Ollama instance — Ollama serves an OpenAI-compatible
# API, so point NIM_BASE_URL at it and set NEMOTRON_MODEL to a pulled model:
#   USE_SELF_HOSTED=true
#   NIM_BASE_URL=http://localhost:11434/v1
#   NIM_API_KEY=ollama          # ignored by Ollama, but must be non-empty
#   NEMOTRON_MODEL=llama3.1     # or whatever you've `ollama pull`ed
USE_SELF_HOSTED=false
NIM_BASE_URL=http://localhost:8000/v1
NIM_API_KEY=not-needed

# Data output directory (dashboard polls public/data/)
SYNTH_DATA_DIR=./public/data

# When true, the TSTR logistic-regression classifier is retrained on accumulated
# history (public/data/checkpoints/) whenever a run's rare-class recall regresses
# vs. the previous run. Off by default — each run trains a fresh throwaway model,
# same as before this flag existed.
RETRAIN_MODEL=false
